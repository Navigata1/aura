{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.profile-revision",
  "description": "profile_revision golden vectors (contracts/README.md, 'Worker protocol'): for the pins a worker describes (code commit, environment lock or image digest, SDK version and the profile's weights manifest), the exact preimage bytes as UTF-8 text and their sha256, hand-derived. Malformed pins expect their error code. The registry, the worker SDK and the conformance suite must reproduce every case.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.profile-revision"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "derivation", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 600},
        "input": {
          "description": "Deliberately loose, so malformed pins can be stated and refused.",
          "type": "object",
          "required": ["code_commit", "env", "sdk_version", "weights_manifest_sha256"],
          "additionalProperties": false,
          "properties": {
            "code_commit": {"type": "string"},
            "env": {"type": "object"},
            "sdk_version": {"type": "string"},
            "weights_manifest_sha256": {"type": ["string", "null"]}
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "required": ["preimage", "profile_revision"],
              "additionalProperties": false,
              "properties": {
                "preimage": {"type": "string", "minLength": 1},
                "profile_revision": {"$ref": "common.schema.json#/$defs/sha256"}
              }
            },
            {
              "type": "object",
              "required": ["invalid"],
              "additionalProperties": false,
              "properties": {"invalid": {"enum": ["code_commit_invalid", "env_invalid", "sdk_version_invalid", "weights_manifest_invalid"]}}
            }
          ]
        }
      }
    }
  }
}
