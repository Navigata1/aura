{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "session/1",
  "description": "One sitting of work, pinned to the compute profile chosen at its start (GLOSSARY: Session). A switch is logged: undispatched jobs are re-planned, jobs awaiting approval are re-quoted (which invalidates the old approval), running jobs finish where they are.",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "started_at", "ended_at", "compute_profile_id", "snapshot_ids", "changes_since_last", "switches"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "session"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "started_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "ended_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/dateTime"}, {"type": "null"}]},
    "compute_profile_id": {"$ref": "common.schema.json#/$defs/id"},
    "snapshot_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "changes_since_last": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortText"}},
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "from_compute_profile_id", "to_compute_profile_id", "replanned_job_ids", "requoted_quote_ids", "invalidated_approval_ids"],
        "additionalProperties": false,
        "properties": {
          "at": {"$ref": "common.schema.json#/$defs/dateTime"},
          "from_compute_profile_id": {"$ref": "common.schema.json#/$defs/id"},
          "to_compute_profile_id": {"$ref": "common.schema.json#/$defs/id"},
          "replanned_job_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
          "requoted_quote_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
          "invalidated_approval_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}}
        }
      }
    }
  }
}
