{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compute-profile/1",
  "description": "The tier preset in force and where each engine profile runs under it (GLOSSARY: Compute profile; O-02, O-09, ADR-0003, ADR-0030). Chosen at install and at every session start, switchable at any time, never changing a project. The burst block carries the monthly cap (owner act to change) and the per-run approval rule: every paid run needs Jon's explicit yes, approvals expire 15 minutes after the quote, and a paid job never retries automatically.",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "tier", "chosen_by", "recommendation", "placements", "burst", "created_at"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "compute-profile"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "tier": {"$ref": "common.schema.json#/$defs/computeTier"},
    "chosen_by": {"enum": ["recommendation", "owner_selected"]},
    "recommendation": {
      "type": "object",
      "required": ["tier", "snapshot_ids", "reasons", "warnings"],
      "additionalProperties": false,
      "properties": {
        "tier": {"$ref": "common.schema.json#/$defs/computeTier"},
        "snapshot_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/shortText"}},
        "warnings": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_id", "placement", "worker_host_id", "reason", "remedy"],
        "additionalProperties": false,
        "properties": {
          "profile_id": {"$ref": "common.schema.json#/$defs/slug"},
          "placement": {"enum": ["local", "worker_host", "burst", "unavailable"]},
          "worker_host_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
          "reason": {"$ref": "common.schema.json#/$defs/shortText"},
          "remedy": {"oneOf": [{"$ref": "common.schema.json#/$defs/shortText"}, {"type": "null"}]}
        },
        "allOf": [
          {"if": {"properties": {"placement": {"const": "unavailable"}}}, "then": {"properties": {"remedy": {"type": "string"}}}},
          {"if": {"properties": {"placement": {"const": "worker_host"}}}, "then": {"properties": {"worker_host_id": {"type": "string"}}}, "else": {"properties": {"worker_host_id": {"type": "null"}}}}
        ]
      }
    },
    "burst": {
      "type": "object",
      "required": ["provider", "cloud", "gpu_class_fallback", "monthly_cap_usd", "per_run_approval", "approval_expiry_minutes", "automatic_paid_retry"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["runpod", "fake"]},
        "cloud": {"enum": ["secure", "community"], "description": "Secure cloud first: unreleased melody and lyrics leave the machine."},
        "gpu_class_fallback": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
        "monthly_cap_usd": {"$ref": "common.schema.json#/$defs/usd"},
        "per_run_approval": {"const": true},
        "approval_expiry_minutes": {"const": 15},
        "automatic_paid_retry": {"const": false}
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
