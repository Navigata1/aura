{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.meter",
  "description": "Meter golden vectors for the TimeModel (ADR-0033; contracts/README.md, 'SongForm assembly'): bar and beat positions across meter changes at 960 PPQ, hand-derived. op position maps a tick to its 1-based bar and beat and the ticks into that beat; op tick maps a 1-based bar and beat to its first tick; an unrepresentable meter map or beat expects its error code. The Python reference and its TypeScript twin must reproduce every case.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.meter"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "derivation", "op", "meter", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 600},
        "op": {"enum": ["position", "tick"]},
        "meter": {"$ref": "melody-spec.schema.json#/$defs/tempoMap/properties/meter"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tick": {"type": "integer", "minimum": 0},
            "bar": {"type": "integer", "minimum": 1},
            "beat": {"type": "integer", "minimum": 1}
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "required": ["bar", "beat", "offset"],
              "additionalProperties": false,
              "properties": {
                "bar": {"type": "integer", "minimum": 1},
                "beat": {"type": "integer", "minimum": 1},
                "offset": {"type": "integer", "minimum": 0}
              }
            },
            {
              "type": "object",
              "required": ["tick"],
              "additionalProperties": false,
              "properties": {"tick": {"type": "integer", "minimum": 0}}
            },
            {
              "type": "object",
              "required": ["invalid"],
              "additionalProperties": false,
              "properties": {"invalid": {"enum": ["meter_segments_invalid", "meter_change_inside_bar", "beat_outside_bar"]}}
            }
          ]
        }
      },
      "if": {"properties": {"op": {"const": "position"}}},
      "then": {"properties": {"input": {"required": ["tick"], "maxProperties": 1}}},
      "else": {"properties": {"input": {"required": ["bar", "beat"], "maxProperties": 2}}}
    }
  }
}
