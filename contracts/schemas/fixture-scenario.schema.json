{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.scenario",
  "description": "A reference-rule case: the valid fixture world plus an overlay that adds or replaces records by identity (and optionally removes some). Every overlay record must be schema-valid; the cross-file rules must then report exactly expect_rules (an empty list means the scenario is valid).",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "description", "expect_rules", "overlay", "remove"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.scenario"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"type": "string", "pattern": "^SC-[A-Z0-9-]{2,60}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 600},
    "expect_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+\\.[a-z_]+$"}},
    "overlay": {"type": "array", "items": {"type": "object", "required": ["kind"]}},
    "remove": {"type": "array", "items": {"type": "array", "minItems": 1}}
  }
}
