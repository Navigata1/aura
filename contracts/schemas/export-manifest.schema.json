{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export-manifest/1",
  "description": "The self-describing record inside an export bundle (GLOSSARY: ExportManifest, Export bundle, Human contribution; ADR-0009, ADR-0019). It is computed from the keeper's closure over derived_from and converted_from edges, never by hand: license_chain, eligible_lanes, release_blockers and the AI-disclosure obligation come from audio ancestry only (license.manifest_chain, lane.export, release.manifest_blockers). closure lists the closure's hashes sorted, and closure_sha256 = sha256 of those hex strings joined by newlines. The loudness report names its standard revision and meter version. converted_vocal is false in v1 (no voice conversion). Every file is decoded and hashed again before the bundle is offered (verified_at).",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "project_id", "keeper_id", "operator_lane", "eligible_lanes", "files",
               "human_contributions", "model_chain", "license_chain", "ai_disclosure", "converted_vocal", "imported_sources",
               "loudness", "dither", "closure", "closure_sha256", "release_blockers", "release_clear", "synthetic_test", "verified_at"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "export-manifest"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "keeper_id": {"$ref": "common.schema.json#/$defs/id"},
    "operator_lane": {"$ref": "common.schema.json#/$defs/operatorLane"},
    "eligible_lanes": {"allOf": [{"$ref": "common.schema.json#/$defs/laneSet"}, {"minItems": 1}]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256", "bytes", "media_type", "audio"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,120}$"},
          "role": {"enum": ["mix_native", "deliverable_48k_24", "midi", "melody_spec", "song_spec", "stem", "residual"]},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"$ref": "common.schema.json#/$defs/mediaType"},
          "audio": {"oneOf": [{"$ref": "common.schema.json#/$defs/audioMeta"}, {"type": "null"}]}
        }
      },
      "contains": {"properties": {"role": {"const": "mix_native"}}}
    },
    "human_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contribution", "detail", "refs"],
        "additionalProperties": false,
        "properties": {
          "contribution": {"enum": ["melody", "lyrics", "corrections", "choices", "edits"]},
          "detail": {"$ref": "common.schema.json#/$defs/shortText"},
          "refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha256"}}
        }
      }
    },
    "model_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_id", "profile_revision"],
        "additionalProperties": false,
        "properties": {"profile_id": {"$ref": "common.schema.json#/$defs/slug"}, "profile_revision": {"$ref": "common.schema.json#/$defs/sha256"}}
      }
    },
    "license_chain": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/licenseEntry"}},
    "ai_disclosure": {
      "type": "object",
      "required": ["required", "reasons"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["generated_audio_in_closure", "component_obligation_ai_disclosure"]}}
      },
      "if": {"properties": {"required": {"const": true}}},
      "then": {"properties": {"reasons": {"minItems": 1}}},
      "else": {"properties": {"reasons": {"maxItems": 0}}}
    },
    "converted_vocal": {"const": false},
    "imported_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["import_terms_id", "source_service", "terms_url", "terms_date"],
        "additionalProperties": false,
        "properties": {
          "import_terms_id": {"$ref": "common.schema.json#/$defs/id"},
          "source_service": {"enum": ["suno", "daw_bounce", "owned_purchase", "licensed"]},
          "terms_url": {"oneOf": [{"$ref": "common.schema.json#/$defs/uri"}, {"type": "null"}]},
          "terms_date": {"oneOf": [{"$ref": "common.schema.json#/$defs/date"}, {"type": "null"}]}
        }
      }
    },
    "loudness": {
      "type": "object",
      "required": ["standard", "meter", "true_peak_meter", "integrated_lufs", "true_peak_dbtp", "label"],
      "additionalProperties": false,
      "properties": {
        "standard": {"enum": ["BS.1770-4", "BS.1770-5"]},
        "meter": {"type": "string", "pattern": "^pyloudnorm [0-9]+\\.[0-9]+\\.[0-9]+$"},
        "true_peak_meter": {"const": "studio-truepeak-4x"},
        "integrated_lufs": {"$ref": "common.schema.json#/$defs/loudness"},
        "true_peak_dbtp": {"$ref": "common.schema.json#/$defs/loudness"},
        "label": {"const": "MEASURED-LOCAL"}
      }
    },
    "dither": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["kind", "seed_source"], "additionalProperties": false,
         "properties": {"kind": {"const": "tpdf"}, "seed_source": {"const": "export_id"}}}
      ]
    },
    "closure": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sha256"}},
    "closure_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "release_blockers": {
      "description": "Every release-blocker class (other than obligations, which travel in license_chain) of every component in the closure, computed from the register (release.manifest_blockers). covered_by names a license acceptance whose release_permission covers this lane, or is null.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "class", "covered_by"],
        "additionalProperties": false,
        "properties": {
          "component_id": {"$ref": "common.schema.json#/$defs/slug"},
          "class": {"$ref": "common.schema.json#/$defs/releaseBlocker"},
          "covered_by": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]}
        }
      }
    },
    "release_clear": {"type": "boolean", "description": "true only when the export's lane is releasable (research never is) and every release blocker is covered. A research export reads 'Not for release (research lane)'."},
    "synthetic_test": {"type": "boolean"},
    "verified_at": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
