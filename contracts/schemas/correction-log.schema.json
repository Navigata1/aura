{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "correction-log/1",
  "description": "Timestamped piano-roll corrections per MelodySpec revision chain; the log is the correction-effort metric (GLOSSARY: Correction; architecture.md §4.6). Each entry turns base_rev into new_rev = base_rev + 1.",
  "type": "object",
  "required": ["kind", "schemaVersion", "melody_id", "project_id", "entries"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "correction-log"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "melody_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "at", "base_rev", "new_rev", "ops"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "at": {"$ref": "common.schema.json#/$defs/dateTime"},
          "base_rev": {"type": "integer", "minimum": 1},
          "new_rev": {"type": "integer", "minimum": 2},
          "ops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "note_ids"],
              "additionalProperties": false,
              "properties": {
                "op": {"enum": ["move", "resize", "transpose", "split", "merge", "add", "delete", "quantize", "set_tempo", "set_meter", "set_key", "mark_phrase"]},
                "note_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^n[0-9]{1,6}$"}},
                "delta_ticks": {"type": "integer"},
                "delta_semitones": {"type": "integer", "minimum": -48, "maximum": 48},
                "us_per_quarter": {"type": "integer", "minimum": 1, "maximum": 16777215},
                "phrase_id": {"type": "string", "pattern": "^ph[0-9]{1,4}$"}
              }
            }
          }
        }
      }
    }
  }
}
