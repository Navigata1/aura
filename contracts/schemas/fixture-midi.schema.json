{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture vectors (midi)",
  "description": "Golden vectors for the MelodySpec <-> Standard MIDI File mapping (studio_ref/midi.py; contracts/README.md, 'MIDI round trip'). Expected SMF bytes are lowercase hex, derived by hand byte by byte; no binary file is committed. A melody here is the MIDI-carried part of a MelodySpec (tempo map and notes), except in a write case, which takes a whole melody-spec record. Section markers use the timeline/1 marker shape; end_tick is where the file ends (the latest End of Track). Inputs are hypothetical inputs to pure functions, not evidence of anything.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.midi"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "smfHex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"},
    "note": {
      "type": "object",
      "required": ["start_tick", "duration_ticks", "pitch", "velocity"],
      "additionalProperties": false,
      "properties": {
        "start_tick": {"$ref": "melody-spec.schema.json#/$defs/note/properties/start_tick"},
        "duration_ticks": {"$ref": "melody-spec.schema.json#/$defs/note/properties/duration_ticks"},
        "pitch": {"$ref": "melody-spec.schema.json#/$defs/note/properties/pitch"},
        "velocity": {"$ref": "melody-spec.schema.json#/$defs/note/properties/velocity"}
      }
    },
    "melody": {
      "type": "object",
      "required": ["tempo_map", "notes"],
      "additionalProperties": false,
      "properties": {
        "tempo_map": {
          "type": "object",
          "required": ["tempo", "meter"],
          "additionalProperties": false,
          "properties": {
            "tempo": {"$ref": "melody-spec.schema.json#/$defs/tempoMap/properties/tempo"},
            "meter": {"$ref": "melody-spec.schema.json#/$defs/tempoMap/properties/meter"}
          }
        },
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}}
      }
    },
    "markers": {"$ref": "timeline.schema.json#/properties/markers"},
    "endTick": {"type": "integer", "minimum": 0, "description": "Where the file ends, at 960 PPQ: on read the latest End of Track; on write the conductor's End of Track when later than every event (an assembled melody's form.end_tick)."},
    "read": {
      "type": "object",
      "required": ["melody", "markers", "end_tick", "not_carried"],
      "additionalProperties": false,
      "properties": {
        "melody": {"$ref": "#/$defs/melody"},
        "markers": {"$ref": "#/$defs/markers"},
        "end_tick": {"$ref": "#/$defs/endTick"},
        "not_carried": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["smf_track", "tick", "event"],
            "additionalProperties": false,
            "properties": {
              "smf_track": {"type": "integer", "minimum": 0},
              "tick": {"type": "integer", "minimum": 0, "description": "At 960 PPQ."},
              "event": {"type": "string", "pattern": "^(ff[0-9a-f]{2}|[89a-e][0-9a-f]|f0|f7)$", "description": "The status byte in hex, or ff and the meta type (ff2f: an End of Track inside the file)."}
            }
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["code", "smf_track", "tick"],
      "additionalProperties": false,
      "properties": {
        "code": {"enum": ["smpte_division", "tempo_outside_model", "meter_outside_model", "tempo_map_ambiguous",
                          "same_pitch_overlap", "track_layout_unsupported", "tick_not_representable",
                          "zero_length_note", "unterminated_note", "meter_change_inside_bar", "end_before_last_event",
                          "malformed_smf"]},
        "smf_track": {"type": ["integer", "null"], "minimum": 0, "description": "The MTrk chunk's index in the file (an SMF track, not a timeline track); null outside every chunk, and on write."},
        "tick": {"type": ["integer", "null"], "minimum": 0, "description": "The tick of the event to blame: on read in the file's own division, once that event's delta time is read; on write in MelodySpec ticks. Null where no event is to blame: the header, a chunk header, a delta time, or a tempo or meter list as a whole."}
      }
    },
    "case": {
      "type": "object",
      "required": ["name", "derivation", "op"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 600},
        "op": {"enum": ["round_trip", "write", "read", "refuse_write", "refuse_read"]},
        "melody": {"type": "object"},
        "markers": {"$ref": "#/$defs/markers"},
        "end_tick": {"oneOf": [{"$ref": "#/$defs/endTick"}, {"type": "null"}], "description": "The writer's end_tick; null ends every SMF track at its own last event."},
        "smf_hex": {"$ref": "#/$defs/smfHex"},
        "read": {"$ref": "#/$defs/read"},
        "refusal": {"$ref": "#/$defs/refusal"}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "round_trip"}}},
          "then": {"required": ["melody", "markers", "end_tick", "smf_hex"],
                   "properties": {"melody": {"$ref": "#/$defs/melody"}, "end_tick": {"$ref": "#/$defs/endTick"}, "read": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "write"}}},
          "then": {"required": ["melody", "markers", "end_tick", "smf_hex"],
                   "properties": {"melody": {"$ref": "melody-spec.schema.json"}, "read": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "read"}}},
          "then": {"required": ["smf_hex", "read"], "properties": {"melody": false, "markers": false, "end_tick": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "refuse_write"}}},
          "then": {"required": ["melody", "markers", "end_tick", "refusal"],
                   "properties": {"melody": {"$ref": "#/$defs/melody"}, "smf_hex": false, "read": false,
                                  "refusal": {"properties": {"smf_track": {"type": "null"}}}}}
        },
        {
          "if": {"properties": {"op": {"const": "refuse_read"}}},
          "then": {"required": ["smf_hex", "refusal"], "properties": {"melody": false, "markers": false, "end_tick": false, "read": false}}
        }
      ]
    }
  }
}
