{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture vectors (midi)",
  "description": "Golden vectors for the MelodySpec <-> Standard MIDI File mapping (studio_ref/midi.py; contracts/README.md, 'MIDI round trip'). Expected SMF bytes are lowercase hex, derived by hand byte by byte; no binary file is committed. A melody here is the MIDI-carried part of a MelodySpec (tempo map and notes), except in a write case, which takes a whole melody-spec record. Section markers use the timeline/1 marker shape. Inputs are hypothetical inputs to pure functions, not evidence of anything.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.midi"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "smfHex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"},
    "note": {
      "type": "object",
      "required": ["start_tick", "duration_ticks", "pitch", "velocity"],
      "additionalProperties": false,
      "properties": {
        "start_tick": {"$ref": "melody-spec.schema.json#/$defs/note/properties/start_tick"},
        "duration_ticks": {"$ref": "melody-spec.schema.json#/$defs/note/properties/duration_ticks"},
        "pitch": {"$ref": "melody-spec.schema.json#/$defs/note/properties/pitch"},
        "velocity": {"$ref": "melody-spec.schema.json#/$defs/note/properties/velocity"}
      }
    },
    "melody": {
      "type": "object",
      "required": ["tempo_map", "notes"],
      "additionalProperties": false,
      "properties": {
        "tempo_map": {
          "type": "object",
          "required": ["tempo", "meter"],
          "additionalProperties": false,
          "properties": {
            "tempo": {"$ref": "melody-spec.schema.json#/$defs/tempoMap/properties/tempo"},
            "meter": {"$ref": "melody-spec.schema.json#/$defs/tempoMap/properties/meter"}
          }
        },
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}}
      }
    },
    "markers": {"$ref": "timeline.schema.json#/properties/markers"},
    "smfTrack": {"type": ["integer", "null"], "minimum": 0, "description": "The MTrk chunk's index in the file (an SMF track, not a timeline track); null before or after every chunk, and on write."},
    "read": {
      "type": "object",
      "required": ["melody", "markers", "not_carried"],
      "additionalProperties": false,
      "properties": {
        "melody": {"$ref": "#/$defs/melody"},
        "markers": {"$ref": "#/$defs/markers"},
        "not_carried": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["smf_track", "tick", "event"],
            "additionalProperties": false,
            "properties": {
              "smf_track": {"type": "integer", "minimum": 0},
              "tick": {"type": "integer", "minimum": 0, "description": "At 960 PPQ."},
              "event": {"type": "string", "pattern": "^(ff[0-9a-f]{2}|[89a-e][0-9a-f]|f0|f7)$", "description": "The status byte in hex, or ff and the meta type."}
            }
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["code", "smf_track", "tick"],
      "additionalProperties": false,
      "properties": {
        "code": {"enum": ["smpte_division", "tempo_outside_model", "meter_outside_model", "tempo_map_ambiguous",
                          "same_pitch_overlap", "track_layout_unsupported", "tick_not_representable",
                          "zero_length_note", "unterminated_note", "malformed_smf"]},
        "smf_track": {"$ref": "#/$defs/smfTrack"},
        "tick": {"type": ["integer", "null"], "minimum": 0, "description": "On read, in the file's own division; null where no event is to blame."}
      }
    },
    "case": {
      "type": "object",
      "required": ["name", "derivation", "op"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 1200},
        "op": {"enum": ["round_trip", "write", "read", "refuse_write", "refuse_read"]},
        "melody": {"type": "object"},
        "markers": {"$ref": "#/$defs/markers"},
        "smf_hex": {"$ref": "#/$defs/smfHex"},
        "read": {"$ref": "#/$defs/read"},
        "refusal": {"$ref": "#/$defs/refusal"}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "round_trip"}}},
          "then": {"required": ["melody", "markers", "smf_hex"], "properties": {"melody": {"$ref": "#/$defs/melody"}, "read": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "write"}}},
          "then": {"required": ["melody", "markers", "smf_hex"], "properties": {"melody": {"$ref": "melody-spec.schema.json"}, "read": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "read"}}},
          "then": {"required": ["smf_hex", "read"], "properties": {"melody": false, "markers": false, "refusal": false}}
        },
        {
          "if": {"properties": {"op": {"const": "refuse_write"}}},
          "then": {"required": ["melody", "markers", "refusal"], "properties": {"melody": {"$ref": "#/$defs/melody"}, "smf_hex": false, "read": false}}
        },
        {
          "if": {"properties": {"op": {"const": "refuse_read"}}},
          "then": {"required": ["smf_hex", "refusal"], "properties": {"melody": false, "markers": false, "read": false}}
        }
      ]
    }
  }
}
