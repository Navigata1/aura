{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.abc",
  "description": "YuE2 ABC emission golden vectors (T02e; contracts/README.md, 'YuE2 ABC emission'). Each case gives a hypothetical assembled MelodySpec, the SongSpec revision it was assembled from and the cot asked for (null: derived from the chord symbols), and the hand-derived result: the native two-voice ABC with the cot used, the lyrics sent and the syllable plan; a typed Ineligible with its reasons in scan order; or the code of the input error raised. The validator re-runs studio_ref.abc.to_abc and requires exact equality. Inputs are not evidence of anything.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.abc"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "derivation", "melody", "song", "cot", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 1200},
        "melody": {"$ref": "melody-spec.schema.json"},
        "song": {"$ref": "song-spec.schema.json"},
        "cot": {"enum": ["melody", "full", null]},
        "expected": {"oneOf": [{"$ref": "#/$defs/abc"}, {"$ref": "#/$defs/ineligible"}, {"$ref": "#/$defs/invalid"}]}
      }
    },
    "abc": {
      "type": "object",
      "required": ["abc"],
      "additionalProperties": false,
      "properties": {
        "abc": {
          "type": "object",
          "required": ["text", "cot", "lyrics", "syllable_plan"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "pattern": "^X:1\nT:\nM:", "minLength": 1, "maxLength": 200000},
            "cot": {"enum": ["melody", "full"]},
            "lyrics": {"type": "string", "minLength": 1, "maxLength": 40000},
            "syllable_plan": {"type": "array", "items": {"$ref": "#/$defs/syllable"}}
          }
        }
      }
    },
    "syllable": {
      "description": "One syllable and the note it is planned on, in a vocal section repeat; a note beyond the last syllable has line and syllable null, a syllable beyond the last note has the note fields null. Ticks are the note's re-quantized start and end.",
      "type": "object",
      "required": ["section_id", "repeat", "line", "syllable", "note_id", "pitch", "start_tick", "end_tick"],
      "additionalProperties": false,
      "properties": {
        "section_id": {"$ref": "song-spec.schema.json#/properties/form/properties/sections/items/properties/id"},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 16},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "syllable": {"type": ["string", "null"], "minLength": 1},
        "note_id": {"oneOf": [{"$ref": "melody-spec.schema.json#/$defs/note/properties/id"}, {"type": "null"}]},
        "pitch": {"type": ["integer", "null"], "minimum": 0, "maximum": 127},
        "start_tick": {"type": ["integer", "null"], "minimum": 0},
        "end_tick": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "ineligible": {
      "type": "object",
      "required": ["ineligible"],
      "additionalProperties": false,
      "properties": {
        "ineligible": {
          "type": "object",
          "required": ["reasons"],
          "additionalProperties": false,
          "properties": {"reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reason"}}}
        }
      }
    },
    "reason": {
      "type": "object",
      "required": ["code", "section_id", "note_id", "tick"],
      "additionalProperties": false,
      "properties": {
        "code": {"enum": ["lyrics_missing", "lyrics_language", "lyrics_unbound", "length_over_limit", "tempo_change",
                          "tempo_not_integer_bpm", "key_unrepresentable", "chords_missing", "chord_unrepresentable",
                          "chord_off_grid", "notes_overlap", "note_requantize_collapse"]},
        "section_id": {"oneOf": [{"$ref": "song-spec.schema.json#/properties/form/properties/sections/items/properties/id"}, {"type": "null"}]},
        "note_id": {"oneOf": [{"$ref": "melody-spec.schema.json#/$defs/note/properties/id"}, {"type": "null"}]},
        "tick": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "invalid": {
      "description": "An input outside the contract: raised as AbcInputError, never an Ineligible.",
      "type": "object",
      "required": ["invalid"],
      "additionalProperties": false,
      "properties": {"invalid": {"enum": ["melody_not_assembled", "form_missing", "song_mismatch", "form_inconsistent"]}}
    }
  }
}
