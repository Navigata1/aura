{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture.songform",
  "description": "SongForm assembly golden vectors (T02c; contracts/README.md, 'SongForm assembly'). Each case gives a hypothetical source MelodySpec, a SongSpec and the new record's identity, and the hand-derived result: the assembled MelodySpec with its form's end frame at sample_rate (the one rounding function, ADR-0033), or a typed refusal. The validator re-runs studio_ref.songform.assemble and requires exact equality. Inputs are not evidence of anything.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.songform"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "derivation", "melody", "song", "output", "sample_rate", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 1200},
        "melody": {"$ref": "melody-spec.schema.json"},
        "song": {"$ref": "song-spec.schema.json"},
        "output": {
          "description": "The assembled record's identity, supplied by the caller; its project is the source's.",
          "type": "object",
          "required": ["melody_id", "rev", "base_rev", "tempo_map_rev", "created_at"],
          "additionalProperties": false,
          "properties": {
            "melody_id": {"$ref": "common.schema.json#/$defs/id"},
            "rev": {"type": "integer", "minimum": 1},
            "base_rev": {"type": ["integer", "null"], "minimum": 1},
            "tempo_map_rev": {"type": "integer", "minimum": 1},
            "created_at": {"$ref": "common.schema.json#/$defs/dateTime"}
          }
        },
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 384000},
        "expected": {"oneOf": [{"$ref": "#/$defs/assembled"}, {"$ref": "#/$defs/refused"}]}
      }
    },
    "assembled": {
      "type": "object",
      "required": ["assembled", "end_frame"],
      "additionalProperties": false,
      "properties": {
        "assembled": {"allOf": [{"$ref": "melody-spec.schema.json"}, {"required": ["form"], "properties": {"spec_kind": {"const": "assembled"}}}]},
        "end_frame": {"type": "integer", "minimum": 0}
      }
    },
    "refused": {
      "type": "object",
      "required": ["refused"],
      "additionalProperties": false,
      "properties": {
        "refused": {
          "type": "object",
          "required": ["code", "section_id", "phrase_id", "note_id"],
          "additionalProperties": false,
          "properties": {
            "code": {"enum": ["source_not_melody", "song_melody_mismatch", "duplicate_section", "duplicate_phrase",
                              "section_kind_mismatch", "missing_phrase", "empty_phrase", "meter_conflict", "tempo_conflict",
                              "note_crosses_phrase_edge", "phrase_overflow", "chord_symbol_misplaced"]},
            "section_id": {"oneOf": [{"$ref": "song-spec.schema.json#/properties/form/properties/sections/items/properties/id"}, {"type": "null"}]},
            "phrase_id": {"oneOf": [{"$ref": "melody-spec.schema.json#/$defs/phrase/properties/id"}, {"type": "null"}]},
            "note_id": {"oneOf": [{"$ref": "melody-spec.schema.json#/$defs/note/properties/id"}, {"type": "null"}]}
          }
        }
      }
    }
  }
}
