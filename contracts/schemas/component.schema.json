{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "component/1 (the component register)",
  "description": "One license-register row per component: code, weights and output terms, obligations, allowed lanes, redistribution blocker, release-blocker classes, process-boundary flag and verification status (GLOSSARY: Component, Component register, Release blocker, Process boundary; ADR-0011). contracts/registry/components.v1.json is regenerated byte-identically by scripts/registry/sync.py from docs/research/evidence-register.json plus the studio's decisions in scripts/registry/register_overlay.json, with the product name neutralized (ADR-0035); never hand-edit it. A component whose release blockers make it non-commercial, research-only, unknown, contested or copyleft must run behind a process boundary.",
  "type": "object",
  "required": ["kind", "schemaVersion", "register_id", "overlay", "generated_from", "components"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "component-register"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "register_id": {"type": "string", "pattern": "^[a-z0-9.-]{1,64}$"},
    "overlay": {"type": "boolean", "description": "True for the test overlay holding fake-* components."},
    "generated_from": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}
      }
    },
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
  },
  "if": {"properties": {"overlay": {"const": false}}},
  "then": {"properties": {"generated_from": {"minItems": 1}}},
  "else": {"properties": {"generated_from": {"maxItems": 0}}},
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "name", "category", "role", "code_license", "weights_license", "output_terms", "gated", "verdict",
                   "verdict_condition", "allowed_lanes", "redistribution_blocker", "release_blockers", "obligations",
                   "process_boundary_required", "verification_status", "v1_path", "test_only", "primary_sources", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/slug"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "category": {"type": "string", "pattern": "^[a-z][a-z-]{1,31}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 600},
        "code_license": {"type": "string", "minLength": 1, "maxLength": 400},
        "weights_license": {"type": "string", "minLength": 1, "maxLength": 400},
        "output_terms": {"type": "string", "minLength": 1, "maxLength": 1200},
        "gated": {"type": ["boolean", "null"]},
        "verdict": {"enum": ["adopt-v1", "evaluate", "watch", "research-only", "reference-only", "reject"]},
        "verdict_condition": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 600}, {"type": "null"}]},
        "allowed_lanes": {"$ref": "common.schema.json#/$defs/laneSet"},
        "redistribution_blocker": {"type": "string", "minLength": 1, "maxLength": 600},
        "release_blockers": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/releaseBlocker"}},
        "obligations": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/obligation"}},
        "process_boundary_required": {"type": "boolean"},
        "verification_status": {"enum": ["confirmed", "corrected", "contested", "refuted", "unverifiable", "unverified", "measured-local"]},
        "v1_path": {"type": "boolean", "description": "On the v1 build path (v1-core, v1-studio or a P6 lane challenger)."},
        "test_only": {"type": "boolean"},
        "primary_sources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uri"}},
        "notes": {"type": "string", "maxLength": 4000}
      },
      "allOf": [
        {
          "if": {"properties": {"release_blockers": {"contains": {"enum": ["non_commercial_weights", "non_commercial_by_author", "research_or_academic", "unknown_license", "contested", "copyleft"]}}}},
          "then": {"properties": {"process_boundary_required": {"const": true}}}
        },
        {
          "if": {"properties": {"release_blockers": {"contains": {"enum": ["non_commercial_weights", "non_commercial_by_author", "research_or_academic", "unknown_license", "permissive_label_nc_data"]}}}},
          "then": {"properties": {"allowed_lanes": {"not": {"contains": {"const": "llc"}}}}}
        }
      ]
    }
  }
}
