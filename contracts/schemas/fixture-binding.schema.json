{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture vectors (evidence-binding inputs)",
  "description": "Golden vectors for studio_ref.binding. Expected findings are hand-derived (each case says how); the validator re-runs the reference and requires exact equality. op prereg checks a benchmark-prereg on its own; op binding checks an evidence-binding with every record it cites. Each embedded record validates against its own kind's schema and is a hypothetical input to a pure function: nothing was rendered, heard or concluded, and no case promotes or demotes anything.",
  "type": "object",
  "required": ["kind", "schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "fixture.binding"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "derivation", "op", "check_id", "records", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 600},
        "op": {"enum": ["prereg", "binding"]},
        "check_id": {"$ref": "common.schema.json#/$defs/id"},
        "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
        "expected": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "record": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["benchmark-prereg", "benchmark-membership", "evidence-binding", "job", "candidate", "audition", "verdict",
                                       "correction-log", "melody-spec", "eval-brief", "eval-set"]}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "benchmark-prereg"}}}, "then": {"$ref": "benchmark-prereg.schema.json"}},
        {"if": {"properties": {"kind": {"const": "benchmark-membership"}}}, "then": {"$ref": "benchmark-membership.schema.json"}},
        {"if": {"properties": {"kind": {"const": "evidence-binding"}}}, "then": {"$ref": "evidence-binding.schema.json"}},
        {"if": {"properties": {"kind": {"const": "job"}}}, "then": {"$ref": "job.schema.json"}},
        {"if": {"properties": {"kind": {"const": "candidate"}}}, "then": {"$ref": "candidate.schema.json"}},
        {"if": {"properties": {"kind": {"const": "audition"}}}, "then": {"$ref": "audition.schema.json"}},
        {"if": {"properties": {"kind": {"const": "verdict"}}}, "then": {"$ref": "verdict.schema.json"}},
        {"if": {"properties": {"kind": {"const": "correction-log"}}}, "then": {"$ref": "correction-log.schema.json"}},
        {"if": {"properties": {"kind": {"const": "melody-spec"}}}, "then": {"$ref": "melody-spec.schema.json"}},
        {"if": {"properties": {"kind": {"const": "eval-brief"}}}, "then": {"$ref": "eval-brief.schema.json"}},
        {"if": {"properties": {"kind": {"const": "eval-set"}}}, "then": {"$ref": "eval-set.schema.json"}}
      ]
    },
    "finding": {
      "enum": ["prereg_hash_mismatch", "case_duplicate", "threshold_missing", "threshold_ambiguous", "decision_unregistered", "asset_unlisted",
               "ceiling_exceeds_cap", "coverage_unreachable", "subject_ungated", "lane_forbidden", "prereg_unresolved", "record_duplicate",
               "membership_unresolved", "subject_unregistered", "eval_set_unresolved", "brief_unresolved", "case_unregistered",
               "candidates_unequal", "job_unresolved", "committed_after_run", "verdict_unresolved", "verdict_synthetic", "correction_unresolved"]
    }
  }
}
